FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_PATH=/app/data/logs.db

WORKDIR /app
COPY backend/requirements.txt backend/requirements-postgres.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements.txt -r /app/backend/requirements-postgres.txt \
    && adduser --system --uid 10001 --no-create-home --disabled-password appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app/data

COPY --chown=appuser:appuser backend/app /app/backend/app
COPY --chown=appuser:appuser backend/scripts/reset_password.py /app/backend/scripts/reset_password.py
COPY --chown=appuser:appuser sample-data /app/sample-data
USER 10001:10001
WORKDIR /app/backend
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
