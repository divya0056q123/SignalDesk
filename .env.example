APP_ENV=development
DATABASE_PATH=/app/data/logs.db
SAMPLE_DATA_ENABLED=true
MAX_UPLOAD_BYTES=5242880
MAX_INGEST_BODY_BYTES=10485760
VITE_PROXY_TARGET=http://backend:8000
# Shared secret for POST /api/ingest (leave empty to disable HTTP ingestion)
INGEST_API_KEY=
INGEST_TENANT_ID=default
# Optional Slack-compatible webhook for alert and anomaly notifications
WEBHOOK_URL=
# --- Login ---
# Generate a stable secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_ENABLED=true
SECRET_KEY=
ALLOW_REGISTRATION=true
BOOTSTRAP_TOKEN=
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- PostgreSQL (optional; leave empty to use SQLite) ---
# DATABASE_URL=postgresql://signaldesk:signaldesk@postgres:5432/signaldesk
DATABASE_URL=
